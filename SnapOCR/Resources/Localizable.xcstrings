{
  "sourceLanguage" : "en",
  "strings" : {
    "A global hotkey lets you start a capture from anywhere, even when SnapOCR is in the background. The default shortcut is ⌃⇧O." : {
      "comment" : "Hotkey step description explaining the hotkey feature and default shortcut",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グローバルホットキーを使用すると、SnapOCR がバックグラウンドにある場合でも、どこからでもキャプチャを開始できます。デフォルトのショートカットは ⌃⇧O です。"
          }
        }
      }
    },
    "About SnapOCR" : {
      "comment" : "About button in footer",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
